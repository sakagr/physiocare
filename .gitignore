# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# Agent configuration: machine-specific settings are ignored; shared project
# configuration (skills, commands, agents, hooks) is tracked.
.claude/*
!.claude/skills/
!.claude/commands/
!.claude/agents/
!.claude/hooks/
!.claude/settings.json

# Session review documents (architecture reviews, plans, walkthroughs).
# Stable path so a later session can read the previous one's output;
# not repository history.
.reviews/*
!.reviews/README.md
!.reviews/deferred-findings.md

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*
.env

# vercel
.vercel

# typescript
*.tsbuildinfo

# verification gate marker and captured output (scripts/verify.mjs)
.verify-ok
.verify.log

# scratch: files staged for manual deletion by the agent tooling
/_to_delete/
next-env.d.ts


# Supabase
.branches
.temp
supabase/snippets/Untitled*

# dotenvx
.env.keys
.env.local
.env.*.local

# Playwright (F3 E2E lane)
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
tests/e2e/.seed.json
