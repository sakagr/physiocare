{
  "name": "physiocare",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:seed": "NODE_ENV=local node supabase/scripts/seed.js",
    "db:seed:prod": "NODE_ENV=production node supabase/scripts/seed.js",
    "db:types": "supabase gen types typescript --local > src/types/database.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "RUN_SUPABASE_INTEGRATION=1 vitest run tests/integration --no-file-parallelism",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "openapi:generate": "vite-node -c vitest.config.mts scripts/generate-openapi.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@mantine/core": "^9.4.2",
    "@mantine/hooks": "^9.4.2",
    "@mantine/notifications": "^9.4.2",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.2",
    "@tabler/icons-react": "^3.45.0",
    "@tanstack/react-query": "^5.101.4",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "next": "16.2.6",
    "pdfkit": "^0.19.1",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.76.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.23",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "supabase": "^2.100.0",
    "typescript": "^5",
    "vite-node": "^2.1.9",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^2.1.9",
    "ws": "^8.21.0"
  }
}
